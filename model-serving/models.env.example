# Sequential local serving configuration for the RTX A4000.
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_PORT=8001
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_IMAGE_LIMIT=1
VLLM_MODEL_CACHE=./data/huggingface

# Use one model at a time. Change this value before starting serve-model.sh.
VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct-AWQ
